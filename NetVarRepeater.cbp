<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="NetVarRepeater" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Service">
				<Option output="NetVarRepeaterService" prefix_auto="1" extension_auto="1" />
				<Option object_output="." />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option parameters="--console" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="ws2_32" />
					<Add library="iphlpapi" />
					<Add library="advapi32" />
				</Linker>
			</Target>
			<Target title="Tray">
				<Option output="NetVarRepeaterTray" prefix_auto="1" extension_auto="1" />
				<Option object_output="." />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DUNICODE" />
					<Add option="-D_UNICODE" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-mwindows" />
					<Add option="-municode" />
					<Add library="shell32" />
					<Add library="user32" />
					<Add library="gdi32" />
					<Add library="comctl32" />
					<Add library="advapi32" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++17" />
			<Add option="-Wall" />
			<Add option="-Wextra" />
			<Add option="-Wno-cast-function-type" />
			<Add option="-m64" />
			<Add option="-D_WIN32_WINNT=0x0601" />
		</Compiler>
		<Linker>
			<Add option="-m64" />
			<Add option="-static" />
			<Add option="-static-libgcc" />
			<Add option="-static-libstdc++" />
		</Linker>
		<Unit filename="common.h" />
		<Unit filename="config.h" />
		<Unit filename="service.cpp">
			<Option target="Service" />
		</Unit>
		<Unit filename="tray.cpp">
			<Option target="Tray" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
